meta {
  name: Login admin - save adminToken
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{adminEmail}}", 
    "password": "{{adminPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3002
}

script:post-response {
   
  const body = res.getBody(); 
  if (res.getStatus() === 200 && body && body.success === true && body.data && body.data.accessToken) { 
    bru.setEnvVar("adminToken", body.data.accessToken); 
    console.log("Saved adminToken from successful admin login."); 
    } else { 
      console.log("Admin login failed or accessToken was missing; existing adminToken was not changed."); 
      } 
}

tests {
   test("successful login returns accessToken", function () { 
  expect(res.getStatus()).to.equal(200); 
  expect(res.getBody().data).to.have.property("accessToken"); 
  }); 
}
