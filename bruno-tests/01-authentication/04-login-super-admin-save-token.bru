meta {
  name: Login super admin - save superAdminToken
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{superAdminEmail}}", 
    "password": "{{superAdminPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3002
}

script:post-response {
   
  const body = res.getBody(); 
  if (res.getStatus() === 200 && body && body.success === true && body.data && body.data.accessToken) { 
    bru.setEnvVar("superAdminToken", body.data.accessToken); 
    console.log("Saved superAdminToken from successful super-admin login."); 
  } else { 
    console.log("Super-admin login failed or accessToken was missing; existing superAdminToken was not changed."); 
  } 
}
