meta {
  name: List restaurants (public)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/restaurants
  body: none
  auth: none
}

vars:pre-request {
  baseUrl: http://localhost:3002
}

tests {
   test("lists restaurants", function () { 
  expect(res.getStatus()).to.equal(200); 
  expect(res.getBody().data).to.be.an("array"); 
  }); 
}
