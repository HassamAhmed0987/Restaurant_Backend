meta {
  name: Get cart (customer)
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/cart
}
headers {
  authorization: Bearer {{customerToken}}
}
tests { 
  test("returns cart shape", 
  function () { 
    expect(res.getStatus()).to.equal(200); 
    expect(res.getBody()).to.have.property("cart"); 
  }); 
}
