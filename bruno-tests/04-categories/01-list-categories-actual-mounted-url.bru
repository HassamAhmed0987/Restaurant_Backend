meta {
  name: List categories (actual mounted URL)
  type: http
  seq: 1
}
get {
  url: {{baseUrl}}/api/restaurants/restaurants/{{restaurantId}}/categories
}
tests { test("lists categories", function () { 
  expect(res.getStatus()).to.equal(200); 
  expect(res.getBody().data).to.be.an("array"); 
  }); 
}
