meta {
  name: Change password (destructive - do not run)
  type: http
  seq: 3
}
patch {
  url: {{baseUrl}}/api/users/changed-password
  body: json
}
headers {
  authorization: Bearer {{customerToken}}
  content-type: application/json
}
body:json {
  {
    "currentPassword": "{{customerPassword}}", 
    "newPassword": "replace-with-a-new-password"
  }
}
tests { test("password changed", function () { 
  expect(res.getStatus()).to.equal(200); 
  }); 
}
